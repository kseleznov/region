generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  username      String         @unique
  bio           String?
  refreshToken  String?
  savedPlaces   SavedPlace[]
  visitedPlaces VisitedPlace[]
  tips          Tip[]
  following     Follow[]       @relation("Following")
  followers     Follow[]       @relation("Followers")
}

model Follow {
  id          Int      @id @default(autoincrement())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followerId  Int
  following   User     @relation("Followers", fields: [followingId], references: [id])
  followingId Int
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Tip {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  place     Place    @relation(fields: [placeId], references: [id])
  placeId   Int
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, placeId])
}

model SavedPlace {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  @@unique([userId, placeId])
}

model Place {
  id              Int                @id @default(autoincrement())
  category        String
  image           String
  photos          Json               @default("[]")
  stars           Float
  price           Int
  isOpen          Boolean
  ratingCount     Int                @default(0)
  ratingBreakdown Json               @default("[0, 0, 0, 0, 0]")
  city            City               @relation(fields: [cityId], references: [id])
  cityId          Int
  translations    PlaceTranslation[]
  savedBy         SavedPlace[]
  visitedBy       VisitedPlace[]
  reviews         Review[]
  tips            Tip[]
}

/// Per-locale text for a Place. `locale` is a lowercase code ("en", "ru").
model PlaceTranslation {
  place        Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId      Int
  locale       String
  name         String
  description  String
  address      String
  workingHours Json
  expectations Json   @default("[]")

  @@id([placeId, locale])
}

model Review {
  id           Int                 @id @default(autoincrement())
  place        Place               @relation(fields: [placeId], references: [id])
  placeId      Int
  author       String
  avatar       String
  rating       Int
  createdAt    DateTime            @default(now())
  translations ReviewTranslation[]
}

/// Per-locale body text for a Review. The author name stays language-neutral.
model ReviewTranslation {
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId Int
  locale   String
  text     String

  @@id([reviewId, locale])
}

model City {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  images       Json              @default("[]")
  location     Json
  translations CityTranslation[]
  places       Place[]
}

/// Per-locale text for a City, including the localised weather label.
model CityTranslation {
  city        City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId      Int
  locale      String
  name        String
  description String
  weather     Json

  @@id([cityId, locale])
}

model VisitedPlace {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  @@unique([userId, placeId])
}

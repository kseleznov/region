generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  username      String         @unique
  bio           String?
  refreshToken  String?
  savedPlaces   SavedPlace[]
  visitedPlaces VisitedPlace[]
  tips          Tip[]
  reviews       Review[]
  following     Follow[]       @relation("Following")
  followers     Follow[]       @relation("Followers")
  notifications        Notification[] @relation("NotificationRecipient")
  notificationsCreated Notification[] @relation("NotificationActor")
}

/// One row per social event delivered to a user's activity feed. `type` is a
/// plain string ("follow") rather than a Prisma enum so adding an event kind
/// is a data change, not a migration — mirrors the `Locale` decision in i18n.
model Notification {
  id          Int      @id @default(autoincrement())
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  /// The user who caused the event. Identity (name/username) is read live from
  /// this relation, never copied onto the row. Nullable so a future
  /// system-generated notification can omit it.
  actor       User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorId     Int?
  type        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
}

model Follow {
  id          Int      @id @default(autoincrement())
  follower    User     @relation("Following", fields: [followerId], references: [id])
  followerId  Int
  following   User     @relation("Followers", fields: [followingId], references: [id])
  followingId Int
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Tip {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  place     Place    @relation(fields: [placeId], references: [id])
  placeId   Int
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, placeId])
}

model SavedPlace {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  @@unique([userId, placeId])
}

model Place {
  id              Int                @id @default(autoincrement())
  category        String
  image           String
  photos          Json               @default("[]")
  stars           Float
  price           Int
  isOpen          Boolean
  ratingCount     Int                @default(0)
  ratingBreakdown Json               @default("[0, 0, 0, 0, 0]")
  city            City               @relation(fields: [cityId], references: [id])
  cityId          Int
  translations    PlaceTranslation[]
  savedBy         SavedPlace[]
  visitedBy       VisitedPlace[]
  reviews         Review[]
  tips            Tip[]
}

/// Per-locale text for a Place. `locale` is a lowercase code ("en", "ru").
model PlaceTranslation {
  place        Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId      Int
  locale       String
  name         String
  description  String
  address      String
  workingHours Json
  expectations Json   @default("[]")

  @@id([placeId, locale])
}

model Review {
  id           Int                 @id @default(autoincrement())
  place        Place               @relation(fields: [placeId], references: [id])
  placeId      Int
  /// Every review is written by a registered user; author name and avatar are
  /// read live from this relation, not stored on the row.
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  rating       Int
  createdAt    DateTime            @default(now())
  translations ReviewTranslation[]

  @@unique([userId, placeId])
}

/// Per-locale body text for a Review.
model ReviewTranslation {
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId Int
  locale   String
  text     String

  @@id([reviewId, locale])
}

model City {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  images       Json              @default("[]")
  location     Json
  translations CityTranslation[]
  places       Place[]
}

/// Per-locale text for a City, including the localised weather label.
model CityTranslation {
  city        City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId      Int
  locale      String
  name        String
  description String
  weather     Json

  @@id([cityId, locale])
}

model VisitedPlace {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  @@unique([userId, placeId])
}

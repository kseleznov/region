generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  refreshToken  String?
  savedPlaces   SavedPlace[]
  visitedPlaces VisitedPlace[]
}

model SavedPlace {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  @@unique([userId, placeId])
}

model Place {
  id              Int            @id @default(autoincrement())
  name            String
  category        String
  description     String
  image           String
  photos          Json           @default("[]")
  stars           Float
  price           Int
  address         String
  isOpen          Boolean
  workingHours    Json
  expectations    Json           @default("[]")
  ratingCount     Int            @default(0)
  ratingBreakdown Json           @default("[0, 0, 0, 0, 0]")
  savedBy         SavedPlace[]
  visitedBy       VisitedPlace[]
  reviews         Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  place     Place    @relation(fields: [placeId], references: [id])
  placeId   Int
  author    String
  avatar    String
  rating    Int
  text      String
  createdAt DateTime @default(now())
}

model City {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  description String
  images      Json   @default("[]")
  location    Json
  weather     Json
}

model VisitedPlace {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  place   Place @relation(fields: [placeId], references: [id])
  placeId Int

  @@unique([userId, placeId])
}
